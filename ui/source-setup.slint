// Shared first-run choice on desktop and Android.
export component SourceSetup inherits Rectangle {
    in property <bool> music-connected;
    in property <brush> background-color: #101012;
    in property <brush> ink: #fff;
    in property <brush> secondary-ink: #ffffffaa;
    callback selected(bool);
    background: root.background-color;
    TouchArea { }
    Flickable {
        width: root.width;
        height: root.height;
        content-width: self.width;
        content-height: max(self.height, form.y + form.preferred-height + 24px);
        form := VerticalLayout {
            x: (root.width - self.width) / 2;
            y: max(24px, (root.height - self.preferred-height) / 2);
            width: min(420px, root.width - 48px);
            spacing: 18px;
            Text {
                text: "YM UNCENSORED";
                font-size: 16px;
                font-weight: 800;
                horizontal-alignment: center;
                color: #78dfb9;
            }
            Text {
                text: "Музыка без цензуры";
                font-size: 28px;
                font-weight: 700;
                horizontal-alignment: center;
                wrap: word-wrap;
                color: root.ink;
            }
            Text {
                text: root.music-connected
                    ? "Осталось подключить поиск полных версий. Подтвердите доступ через Яндекс ID — дальше плеер будет находить и проверять замены автоматически."
                    : "Войдите в музыку и подтвердите поиск полных версий через Яндекс ID. Дальше плеер будет находить и проверять замены автоматически.";
                font-size: 16px;
                horizontal-alignment: center;
                wrap: word-wrap;
                color: root.secondary-ink;
            }
            Rectangle { height: 6px; }
            Rectangle {
                height: 64px;
                border-radius: 20px;
                background: enable.pressed ? #59c59e : #78dfb9;
                Text {
                    x: 16px;
                    width: parent.width - 32px;
                    text: root.music-connected ? "Включить версии без цензуры" : "Войти и включить версии без цензуры";
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 16px;
                    font-weight: 600;
                    color: #101012;
                }
                enable := TouchArea { mouse-cursor: pointer; clicked => { root.selected(true); } }
            }
            Rectangle {
                height: 52px;
                border-radius: 20px;
                background: plain.pressed ? #ffffff22 : #ffffff0d;
                Text {
                    text: "Только обычный плеер";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 15px;
                    color: root.ink;
                }
                plain := TouchArea { mouse-cursor: pointer; clicked => { root.selected(false); } }
            }
            Text {
                text: "Музыкальный токен и исходное аудио остаются на устройстве. Сервис получает только название, исполнителей и длительность.";
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
                color: root.secondary-ink;
            }
        }
    }
}
